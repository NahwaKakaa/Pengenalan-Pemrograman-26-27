{
  // Tekan Cmd+Shift+B (Mac) / Ctrl+Shift+B (Windows) saat membuka file .cpp
  // untuk compile dan langsung menjalankannya di terminal.
  // Hasil compile disimpan di folder sementara, jadi tidak ikut ter-commit.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile & Run C++",
      "type": "shell",
      "command": "g++ -std=c++17 -Wall \"${file}\" -o \"${env:TMPDIR}${fileBasenameNoExtension}.out\" && clear && \"${env:TMPDIR}${fileBasenameNoExtension}.out\"",
      "windows": {
        "command": "g++ -std=c++17 -Wall \"${file}\" -o \"${env:TEMP}\\${fileBasenameNoExtension}.exe\"; if ($?) { & \"${env:TEMP}\\${fileBasenameNoExtension}.exe\" }"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
